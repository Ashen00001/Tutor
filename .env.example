# Tailscale auth key: https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=tskey-auth-xxxxxxxx
TS_HOSTNAME=jp-tutor

# Optional: sync with AnkiWeb so the deck also shows up in Anki on your phone/desktop.
# The password is only used on first boot to get a login key; setup.sh blanks it afterwards.
ANKIWEB_USERNAME=
ANKIWEB_PASSWORD=

JP_TUTOR_DECK=Japanese Tutor
# true = also make English -> Japanese cards for every new word
JP_TUTOR_PRODUCTION_CARDS=false
